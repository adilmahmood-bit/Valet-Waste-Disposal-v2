# Copy to .env.local and fill in. Never commit real values.

# Supabase (already used by the site)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Residential: server-only key that can write the res_* tables (Supabase > Project Settings > API keys > Secret key)
SUPABASE_SECRET_KEY=

# Residential: encrypts gate codes. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GATE_CODE_KEY=

# Residential admin (/admin/residential)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# HubSpot private app (Settings > Integrations > Private Apps). Scopes: crm.objects.contacts.read/write,
# crm.objects.deals.read/write, crm.schemas.contacts.read/write, crm.schemas.deals.read/write, forms.
# Then run: node scripts/hubspot-setup.mjs
HUBSPOT_TOKEN=
HUBSPOT_PORTAL_ID=246187700
# Owner for quote-request tasks (Adil)
HUBSPOT_OWNER_ID=92302295
# Printed by scripts/hubspot-setup.mjs
HUBSPOT_FORM_SIGNUP=
HUBSPOT_FORM_WAITLIST=
HUBSPOT_FORM_QUOTE=

# Email. Leave empty to only log emails (admin > Sync shows them).
RESEND_API_KEY=
EMAIL_FROM=
